# Salin menjadi .env lalu sesuaikan. Jangan commit file .env.
#
# Catatan:
# - Untuk Docker Compose, NEO4J_URI sudah di-override di dalam container.
# - Untuk run lokal (tanpa Docker), gunakan NEO4J_URI=bolt://localhost:7687.

NEO4J_USER=neo4j
NEO4J_PASSWORD=runeterra123
NEO4J_DATABASE=neo4j
NEO4J_URI=bolt://localhost:7687

NEO4J_HEAP_INITIAL=512m
NEO4J_HEAP_MAX=1G
NEO4J_PAGECACHE=512m

DATA_DIR=./data
PROCESSED_DIR=./data/processed
BATCH_SIZE=500

QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=cards
EMBEDDING_MODEL=intfloat/multilingual-e5-large
EMBEDDING_DIM=1024

# Untuk bagian integrasi/LLM (Kesan)
LLM_API_KEY=
LLM_MODEL=
